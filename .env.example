# Copy to .env and fill in. Never commit the real .env.

# Target WordPress site. MUST be a self-hosted / intentionally vulnerable
# instance you are authorized to test (e.g. the bundled docker-compose target).
WP_TARGET_URL=http://localhost:8090

# AI agent auth (--ai mode). You need ONE of:
#   (a) a Claude Pro/Max subscription login — run `claude setup-token` once, or
#   (b) an Anthropic API key below.
# Either way AI mode needs Node.js installed. --no-ai needs none of this.
ANTHROPIC_API_KEY=

# Optional: override the model the agent uses (default: claude-opus-5-5).
# A cheaper model is fine for this task, e.g. claude-haiku-5-5.
WP_ENUM_MODEL=claude-opus-5-5
